# Copy to .env and fill in. .env is gitignored and must never be committed.
# Only the key for the provider you're using needs a value.

# NVIDIA NIM — eval workhorse (~40 req/min, no daily cap).
# Get one at https://build.nvidia.com (free NVIDIA Developer Program, no card).
NVIDIA_API_KEY=

# OpenRouter — development and hand-testing (50 req/day on the free tier).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face — Inference Providers ($2/month on Pro) and Hub pushes.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
